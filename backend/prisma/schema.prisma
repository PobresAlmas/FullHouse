model mensagem {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversa_id           String             @db.Uuid
  autor_participacao_id String             @db.Uuid
  conteudo              String
  responde_mensagem_id  String?            @db.Uuid
  enviada_em            DateTime           @default(now()) @db.Timestamptz(6)
  excluido_em           DateTime?          @db.Timestamptz(6)
  leitura_conversa      leitura_conversa[]

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model alocacao_pagamento {
  pagamento_id      String         @db.Uuid
  rateio_despesa_id String         @db.Uuid
  valor             Decimal        @db.Decimal(12, 2)
  pagamento         pagamento      @relation(fields: [pagamento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rateio_despesa    rateio_despesa @relation(fields: [rateio_despesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([pagamento_id, rateio_despesa_id])
}

model anuncio_quarto {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casa_id                    String              @db.Uuid
  titulo                     String              @db.VarChar(150)
  descricao                  String?
  valor_mensal               Decimal             @db.Decimal(10, 2)
  cidade                     String              @db.VarChar(100)
  bairro                     String?             @db.VarChar(100)
  status                     status_anuncio_enum @default(ABERTO)
  exibir_endereco            Boolean             @default(false)
  endereco_referencia        String?             @db.VarChar(255)
  exibir_contato             Boolean             @default(false)
  criado_por_participacao_id String              @db.Uuid
  casa                       casa                @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao               participacao        @relation(fields: [criado_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interesse_anuncio          interesse_anuncio[]

  @@index([cidade, bairro], map: "idx_anuncio_quarto_cidade_bairro")
}

model casa {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String                   @db.VarChar(150)
  cidade                  String?                  @db.VarChar(100)
  bairro                  String?                  @db.VarChar(100)
  status                  status_casa_enum         @default(ATIVA)
  criada_por_usuario_id   String                   @db.Uuid
  fechada_em              DateTime?                @db.Timestamptz(6)
  excluido_em             DateTime?                @db.Timestamptz(6)
  anuncio_quarto          anuncio_quarto[]
  usuario                 usuario                  @relation(fields: [criada_por_usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  configuracao_casa       configuracao_casa?
  conversa                conversa[]
  convite_casa            convite_casa[]
  definicao_tarefa        definicao_tarefa[]
  despesa                 despesa[]
  fundo_reserva           fundo_reserva?
  item_despensa           item_despensa[]
  lancamento_financeiro   lancamento_financeiro[]
  notificacao             notificacao[]
  pagamento               pagamento[]
  participacao            participacao[]
  penalidade              penalidade[]
  perfil_convivencia_casa perfil_convivencia_casa?
  pet                     pet[]
  proposta_regra          proposta_regra[]
  regra_convivencia       regra_convivencia[]
  reuniao                 reuniao[]
  subgrupo                subgrupo[]
}

model comprovante_pagamento {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateio_despesa_id           String?                       @db.Uuid
  pagamento_id                String?                       @db.Uuid
  arquivo_url                 String                        @db.VarChar(500)
  tipo_arquivo                tipo_arquivo_comprovante_enum
  enviado_por_participacao_id String                        @db.Uuid
  participacao                participacao                  @relation(fields: [enviado_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pagamento                   pagamento?                    @relation(fields: [pagamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateio_despesa              rateio_despesa?               @relation(fields: [rateio_despesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model configuracao_casa {
  casa_id                     String                 @id @db.Uuid
  penalidade_ativa            Boolean                @default(true)
  tolerancia_padrao_horas     Int                    @default(24) @db.SmallInt
  ocorrencias_para_penalidade Int                    @default(1) @db.SmallInt
  penalidade_valor_padrao     Decimal                @default(0) @db.Decimal(10, 2)
  limite_negociacoes          Int                    @default(3) @db.SmallInt
  periodo_renovacao_limites   periodo_renovacao_enum @default(MENSAL)
  votacao_regras_obrigatoria  Boolean                @default(true)
  quorum_minimo_aprovacao     Int                    @default(1) @db.SmallInt
  prazo_aprovacao_regra_dias  Int                    @default(7) @db.SmallInt
  estrategia_rateio_padrao    estrategia_rateio_enum @default(IGUALITARIO)
  casa                        casa                   @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model conversa {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casa_id          String             @db.Uuid
  subgrupo_id      String?            @unique @db.Uuid
  tipo             tipo_conversa_enum
  titulo           String?            @db.VarChar(150)
  casa             casa               @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subgrupo         subgrupo?          @relation(fields: [subgrupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leitura_conversa leitura_conversa[]
  mensagem         mensagem[]
}

model convite_casa {
  id                                                                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casa_id                                                               String              @db.Uuid
  codigo_pessoal_convidado                                              String?             @db.Char(6)
  usuario_convidado_id                                                  String?             @db.Uuid
  convidado_por_participacao_id                                         String              @db.Uuid
  status                                                                status_convite_enum @default(PENDENTE)
  expira_em                                                             DateTime            @db.Timestamptz(6)
  casa                                                                  casa                @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao_convite_casa_convidado_por_participacao_idToparticipacao participacao        @relation("convite_casa_convidado_por_participacao_idToparticipacao", fields: [convidado_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                                                               usuario?            @relation(fields: [usuario_convidado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participacao_participacao_convite_idToconvite_casa                    participacao[]      @relation("participacao_convite_idToconvite_casa")

  @@index([casa_id], map: "idx_convite_casa_casa")
}

model cuidado_pet {
  id                                                                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pet_id                                                                String        @db.Uuid
  tipo                                                                  String        @db.VarChar(50)
  data_cuidado                                                          DateTime      @db.Date
  valor                                                                 Decimal?      @db.Decimal(10, 2)
  pago_por_participacao_id                                              String?       @db.Uuid
  despesa_id                                                            String?       @db.Uuid
  proxima_ocorrencia                                                    DateTime?     @db.Date
  registrado_por_participacao_id                                        String        @db.Uuid
  despesa                                                               despesa?      @relation(fields: [despesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participacao_cuidado_pet_pago_por_participacao_idToparticipacao       participacao? @relation("cuidado_pet_pago_por_participacao_idToparticipacao", fields: [pago_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pet                                                                   pet           @relation(fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao_cuidado_pet_registrado_por_participacao_idToparticipacao participacao  @relation("cuidado_pet_registrado_por_participacao_idToparticipacao", fields: [registrado_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model definicao_tarefa {
  id                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escopo                           escopo_tarefa_enum
  casa_id                          String?                  @db.Uuid
  usuario_id                       String?                  @db.Uuid
  titulo                           String                   @db.VarChar(150)
  cor                              String?                  @db.Char(7)
  periodicidade                    periodicidade_enum
  intervalo_dias                   Int?                     @db.SmallInt
  regra_recorrencia                Json?
  tipo_atribuicao                  tipo_atribuicao_enum
  responsavel_fixo_participacao_id String?                  @db.Uuid
  visibilidade                     visibilidade_tarefa_enum @default(PUBLICA)
  tolerancia_horas                 Int?                     @db.SmallInt
  gera_penalidade                  Boolean                  @default(false)
  valor_penalidade                 Decimal?                 @db.Decimal(10, 2)
  data_inicio                      DateTime                 @db.Date
  data_fim                         DateTime?                @db.Date
  casa                             casa?                    @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao                     participacao?            @relation(fields: [responsavel_fixo_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                          usuario?                 @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fila_rodizio                     fila_rodizio[]
  instancia_tarefa                 instancia_tarefa[]

  @@index([casa_id], map: "idx_definicao_tarefa_casa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model despesa {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  escopo                   escopo_despesa_enum
  casa_id                  String?                   @db.Uuid
  usuario_id               String?                   @db.Uuid
  subgrupo_id              String?                   @db.Uuid
  descricao                String                    @db.VarChar(255)
  valor_total              Decimal                   @db.Decimal(12, 2)
  tipo                     tipo_despesa_enum
  estrategia_rateio        estrategia_rateio_enum
  visibilidade             visibilidade_despesa_enum @default(PUBLICA)
  data_vencimento          DateTime?                 @db.Date
  pago_por_participacao_id String?                   @db.Uuid
  status                   status_despesa_enum       @default(ABERTA)
  quitada_em               DateTime?                 @db.Timestamptz(6)
  cuidado_pet              cuidado_pet[]
  casa                     casa?                     @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao             participacao?             @relation(fields: [pago_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subgrupo                 subgrupo?                 @relation(fields: [subgrupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                  usuario?                  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lancamento_financeiro    lancamento_financeiro[]
  lembrete                 lembrete[]
  rateio_despesa           rateio_despesa[]

  @@index([casa_id], map: "idx_despesa_casa")
}

model fila_rodizio {
  definicao_tarefa_id String           @db.Uuid
  ordem               Int              @db.SmallInt
  participacao_id     String           @db.Uuid
  ativo               Boolean          @default(true)
  definicao_tarefa    definicao_tarefa @relation(fields: [definicao_tarefa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao        participacao     @relation(fields: [participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([definicao_tarefa_id, ordem])
}

model fundo_reserva {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casa_id                 String                       @unique @db.Uuid
  nome                    String                       @db.VarChar(150)
  tipo_contribuicao       tipo_contribuicao_fundo_enum
  valor_contribuicao_fixa Decimal?                     @db.Decimal(12, 2)
  meta                    Decimal?                     @db.Decimal(12, 2)
  casa                    casa                         @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lancamento_financeiro   lancamento_financeiro[]
}

model instancia_tarefa {
  id                                                                        String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definicao_tarefa_id                                                       String                       @db.Uuid
  data_prevista                                                             DateTime                     @db.Date
  prazo_limite                                                              DateTime?                    @db.Timestamptz(6)
  responsavel_participacao_id                                               String?                      @db.Uuid
  responsavel_usuario_id                                                    String?                      @db.Uuid
  ordem_rodizio                                                             Int?                         @db.SmallInt
  status                                                                    status_instancia_tarefa_enum @default(PENDENTE)
  concluida_em                                                              DateTime?                    @db.Timestamptz(6)
  concluida_por_participacao_id                                             String?                      @db.Uuid
  participacao_instancia_tarefa_concluida_por_participacao_idToparticipacao participacao?                @relation("instancia_tarefa_concluida_por_participacao_idToparticipacao", fields: [concluida_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  definicao_tarefa                                                          definicao_tarefa             @relation(fields: [definicao_tarefa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao_instancia_tarefa_responsavel_participacao_idToparticipacao   participacao?                @relation("instancia_tarefa_responsavel_participacao_idToparticipacao", fields: [responsavel_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                                                                   usuario?                     @relation(fields: [responsavel_usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lembrete                                                                  lembrete[]
  penalidade                                                                penalidade[]
  solicitacao_troca_tarefa                                                  solicitacao_troca_tarefa[]

  @@unique([definicao_tarefa_id, data_prevista], map: "uq_instancia_tarefa_data")
  @@index([definicao_tarefa_id], map: "idx_instancia_tarefa_definicao")
  @@index([responsavel_participacao_id], map: "idx_instancia_tarefa_responsavel")
}

model interesse_anuncio {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anuncio_id     String                        @db.Uuid
  usuario_id     String                        @db.Uuid
  mensagem       String?
  status         status_interesse_anuncio_enum @default(PENDENTE)
  anuncio_quarto anuncio_quarto                @relation(fields: [anuncio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario                       @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model item_despensa {
  id                                                                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  casa_id                                                             String                  @db.Uuid
  nome                                                                String                  @db.VarChar(150)
  propriedade                                                         propriedade_item_enum
  dono_participacao_id                                                String?                 @db.Uuid
  unidade                                                             unidade_item_enum
  quantidade_minima                                                   Decimal?                @db.Decimal(10, 2)
  data_validade                                                       DateTime?               @db.Date
  criado_por_participacao_id                                          String                  @db.Uuid
  casa                                                                casa                    @relation(fields: [casa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao_item_despensa_criado_por_participacao_idToparticipacao participacao            @relation("item_despensa_criado_por_participacao_idToparticipacao", fields: [criado_por_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participacao_item_despensa_dono_participacao_idToparticipacao       participacao?           @relation("item_despensa_dono_participacao_idToparticipacao", fields: [dono_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lembrete                                                            lembrete[]
  movimentacao_despensa                                               movimentacao_despensa[]

  @@index([casa_id], map: "idx_item_despensa_casa")
}


  mensagem              mensagem?          @relation("mensagemTomensagem", fields: [responde_mensagem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_mensagem        mensagem[]         @relation("mensagemTomensagem")

  @@index([conversa_id], map: "idx_mensagem_conversa")
}

model movimentacao_despensa {
  id               String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_despensa_id String                          @db.Uuid
  tipo             tipo_movimentacao_despensa_enum
  quantidade       Decimal                         @db.Decimal(10, 2)
  participacao_id  String                          @db.Uuid
  ocorrido_em      DateTime                        @default(now()) @db.Timestamptz(6)
  item_despensa    item_despensa                   @relation(fields: [item_despensa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao     participacao                    @relation(fields: [participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model negociacao_penalidade {
  id                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  penalidade_id               String                 @db.Uuid
  solicitante_participacao_id String                 @db.Uuid
  justificativa               String
  status                      status_negociacao_enum @default(PENDENTE)
  prazo_votacao               DateTime?              @db.Timestamptz(6)
  penalidade                  penalidade             @relation(fields: [penalidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao                participacao           @relation(fields: [solicitante_participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voto_negociacao             voto_negociacao[]
}

model notificacao {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String                @db.Uuid
  casa_id       String?               @db.Uuid
  tipo          tipo_notificacao_enum
  titulo        String                @db.VarChar(150)
  mensagem      String?

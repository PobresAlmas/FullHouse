model leitura_conversa {
  conversa_id             String       @db.Uuid
  participacao_id         String       @db.Uuid
  ultima_mensagem_lida_id String?      @db.Uuid
  atualizado_em           DateTime     @default(now()) @db.Timestamptz(6)
  conversa                conversa     @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participacao            participacao @relation(fields: [participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mensagem                mensagem?    @relation(fields: [ultima_mensagem_lida_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([conversa_id, participacao_id])
}

model lembrete {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String            @db.Uuid
  titulo              String            @db.VarChar(150)
  lembrar_em          DateTime          @db.Timestamptz(6)
  instancia_tarefa_id String?           @db.Uuid
  despesa_id          String?           @db.Uuid
  rateio_despesa_id   String?           @db.Uuid
  item_despensa_id    String?           @db.Uuid
  enviado             Boolean           @default(false)
  despesa             despesa?          @relation(fields: [despesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  instancia_tarefa    instancia_tarefa? @relation(fields: [instancia_tarefa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_despensa       item_despensa?    @relation(fields: [item_despensa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateio_despesa      rateio_despesa?   @relation(fields: [rateio_despesa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario             usuario           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model membro_subgrupo {
  subgrupo_id     String       @db.Uuid
  participacao_id String       @db.Uuid
  entrou_em       DateTime     @default(now()) @db.Timestamptz(6)
  saiu_em         DateTime?    @db.Timestamptz(6)
  participacao    participacao @relation(fields: [participacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subgrupo        subgrupo     @relation(fields: [subgrupo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([subgrupo_id, participacao_id])
